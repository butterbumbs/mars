### Load "mars" package
library(mars)
set.seed(2026)
# Example 1:
load(system.file("testdata", "marstestdata.rda", package="mars"))
m <- mars(y~.,
marstestdata,
control = list(Mmax = 2L, d = 3, trace = FALSE))
summary(m)
print(m)
predict(m, newdata = marstestdata)
anova(m)
plot(m)
#Example 2: Spotify data, predicting popularity of songs
#data from: https://www.kaggle.com/datasets/maharshipandya/-spotify-tracks-dataset
spotify <- read.csv("data/spotify.csv")
fit <- mars(popularity ~. , spotify, control = mars.control(Mmax=4))
summary(fit)
anova(fit)
# Example 3: Airbnb prediction on rental price
## dataset from TidyTuesday
anb <- read.csv("data/Python - New York City Airbnb Open Data.csv")
anb <- na.omit(anb)
fit <- mars(price ~. , anb, control = mars.control(Mmax=4))
summary(fit)
predict(fit, newdata = anb)
anova(fit)
plot(fit)
# Example 4: Pima Indians Diabetes (Pima) dataset, predict chance of diabetes for women
# data from: National Institute of Diabetes and Digestive and Kidney Diseases
diabetes <- read.csv("data/diabetes.csv")
fit <- mars(X0.627 ~. , diabetes, control = mars.control(Mmax=4))
summary(fit)
predict(fit, newdata = anb)
anova(fit)
plot(fit)
